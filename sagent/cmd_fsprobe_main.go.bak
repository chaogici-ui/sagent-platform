package main

import (
	"fmt"

	"github.com/shirou/gopsutil/v4/disk"
)

func main() {
	ps, err := disk.Partitions(false)
	fmt.Println("Partitions(false): err=", err, "n=", len(ps))
	for _, p := range ps {
		fmt.Println("  ", p.Device, p.Mountpoint, p.Fstype, p.Opts)
	}
	ps2, err2 := disk.Partitions(true)
	fmt.Println("Partitions(true): err=", err2, "n=", len(ps2))
	for _, p := range ps2[:min(5, len(ps2))] {
		u, uerr := disk.Usage(p.Mountpoint)
		fmt.Println("  ", p.Device, p.Mountpoint, p.Fstype, "usage_err=", uerr, "total=", u.Total)
	}
}
