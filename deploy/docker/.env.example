# SAgent 部署环境变量模板
# 复制为同目录 .env 后按环境修改（docker compose 自动读取），红线 2：环境值一律走 env，禁止改代码
# 参考约束文档：CONSTRAINTS.md

# 宿主机 docker.sock 路径（l0-console 借它探测演示 Agent 容器状态）
# Docker Desktop / macOS 常为 ~/.docker/run/docker.sock；Linux 为 /var/run/docker.sock
DOCKER_SOCK=/var/run/docker.sock

# vm-host 演示主机 deploy 账号口令（必填，无默认值——弱口令默认值已移除）
SSH_DEPLOY_PASSWORD=

# MySQL 测试容器 root 口令（必填，无默认值）
MYSQL_ROOT_PASSWORD=

# Grafana 管理员密码（默认 admin 仅限本机演示，生产必须覆盖）
GRAFANA_ADMIN_PASSWORD=admin

# 浏览器可达的 Grafana 地址（l0-console 前端指标浏览跳转用；反代/远程部署改此值）
GRAFANA_PUBLIC_URL=http://localhost:3000

# 浏览器可达的 VictoriaMetrics 地址（vmui 跳转用；不设则前端按访问地址推导 8428 端口）
# VM_PUBLIC_URL=

# 演示 Agent 种子开关：本机演示设 1；生产部署必须留空（红线 3：生产零演示数据）
SEED_DEMO_AGENTS=1

# 审计操作者标识（l0-console 审计记录的 operator 字段；生产建议改为真实账号体系标识）
AUDIT_OPERATOR=admin

# 架构 D5 IN5 B3/B4 灰度开关：执行端总开关，作用于「支持集」内的 atom
#   inprocess（默认）= 进程内起 ansible 作业（旧路径，可随时回滚）
#   runner          = 投递 L1 Ansible Runner（执行面搬迁后唯一路径）
# 支持集：install（B3）+ 卸载侧四步 scan_collectors/uninstall_plugins/cleanup_autostart/uninstall（B4）
# 留空/非法值一律回落 inprocess——开关的语义是"敢不敢切"，切错必须能一句话切回
# L1_EXEC_EXECUTOR=inprocess

# B3 期的旧开关名：仅在 L1_EXEC_EXECUTOR 未设置时兜底，避免两处同时生效互相打架
# L1_INSTALL_EXECUTOR=inprocess

# 接收安装任务的 L1 执行端身份（投递端与 Runner 侧必须一致，否则任务永远停在 pending）
# L1_ANSIBLE_RUNNER_ID=l1-ansible-runner-1

# ==================== 架构 D1：目录库（PostgreSQL 唯一载体） ====================
# 目录库已全面切 PG，SQLite 回退已移除：CATALOG_DSN 必填，置空则 l0-console 启动快速失败。
# 容器内按服务名连（postgres 是 compose 服务名，走 l0-net）：
# CATALOG_DSN=postgres://sagent:sagent@postgres:5432/sagent?sslmode=disable

# 单测载体（宿主 `go test`）：postgres 端口只绑回环 127.0.0.1，单测走 sagent_test 库。
# 每用例在库内开独立 schema（testpg.Provision），用例间互不可见；未设置则单测整体 skip。
# 存量数据卷不会重跑 init 脚本，需手工建一次库：
#   docker exec l0-postgres psql -U sagent -d postgres -c 'CREATE DATABASE sagent_test OWNER sagent'
# CATALOG_TEST_DSN=postgres://sagent:sagent@127.0.0.1:55432/sagent_test?sslmode=disable

# PG 宿主机回环端口（宿主 go test 用；不对外网暴露）
# PG_HOST_PORT=55432
